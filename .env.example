# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=meetmemo
DB_PASSWORD=meetmemo
DB_NAME=meetmemo

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Auth
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3001

# Storage
STORAGE_PATH=/data/uploads

# LDAP / AD (optional)
LDAP_ENABLED=false
LDAP_SERVER=ldap://ldap.example.com:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# OIDC / Azure AD (optional)
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_SCOPE=openid profile email

# Whisper
MODEL_DOWNLOAD_SOURCE=modelscope  # "modelscope" or "huggingface"
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=auto

# HF token (for HuggingFace mode or pyannote on HF)
HF_TOKEN=

# LLM
# 三种模式可选：
#   1) ollama     - 本地 Ollama (默认)
#   2) openai     - 直接调用 OpenAI API
#   3) litellm    - 通过 LiteLLM 代理路由到任意模型
LLM_PROVIDER=ollama
LLM_MODEL=llama3
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
# LiteLLM 代理地址 (仅 LLM_PROVIDER=litellm 时需要)
LLM_PROXY_URL=
# LLM_MODEL 示例:
#   ollama:  llama3, qwen2, mistral
#   openai:  gpt-4o, gpt-4o-mini
#   litellm: openai/gpt-4o, claude-sonnet-4-20250514, gemini/gemini-2.0-flash, azure/gpt-4
