# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=meetmemo
DB_PASSWORD=meetmemo
DB_NAME=meetmemo

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Auth
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3001

# Storage
STORAGE_PATH=/data/uploads

# LDAP / AD (optional)
LDAP_ENABLED=false
LDAP_SERVER=ldap://ldap.example.com:389
# 测试域 AI 技术中心示例:
# LDAP_BASE_DN=OU=人工智能技术中心,OU=中央研究院,OU=IT,OU=myse,DC=dltornado2,DC=com
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_DOMAIN=example.com
LDAP_USER_SEARCH_FILTER=(sAMAccountName={})
LDAP_GROUP_MEMBER_FILTER=(member={})

# OIDC / Azure AD (optional)
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_SCOPE=openid profile email

# ASR — remote SenseVoice on AI server (recommended)
ASR_PROVIDER=sensevoice
SENSEVOICE_MODE=remote
SENSEVOICE_API_URL=http://your-ai-server:8003
# Client-side fallback slice only when remote /health lacks vad_enabled (legacy server)
SENSEVOICE_CHUNK_SECONDS=3600
SENSEVOICE_REQUEST_TIMEOUT_MAX=7200

# Chinese punctuation restoration after ASR (FunASR ct-punc)
PUNCTUATION_ENABLED=true
PUNCTUATION_MODEL=ct-punc-c

# Diarization — remote pyannote on AI server (recommended)
DIARIZE_PROVIDER=remote
DIARIZE_API_URL=http://your-ai-server:8002
DIARIZE_MERGE_MIN_OVERLAP_SEC=0.3
DIARIZE_MERGE_MIN_OVERLAP_RATIO=0.05

# Whisper (only when ASR_PROVIDER=faster-whisper)
MODEL_DOWNLOAD_SOURCE=modelscope  # "modelscope" or "huggingface"
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=auto

# HF token (for HuggingFace mode or pyannote on HF)
HF_TOKEN=

# LLM
# 三种模式可选：
#   1) ollama     - 本地 Ollama (默认)
#   2) openai     - 直接调用 OpenAI API
#   3) litellm    - 通过 LiteLLM 代理路由到任意模型
LLM_PROVIDER=ollama
LLM_MODEL=llama3
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
# LiteLLM 代理地址 (仅 LLM_PROVIDER=litellm 时需要)
LLM_PROXY_URL=
# Long meetings: map-reduce summarization (no head truncation) when transcript exceeds threshold
SUMMARY_MAP_REDUCE_THRESHOLD=12000
SUMMARY_MAX_CHUNK_CHARS=10000
# LLM_MODEL 示例:
#   ollama:  llama3, qwen2, mistral
#   openai:  gpt-4o, gpt-4o-mini
#   litellm: vllm/deepseek-v4-flash  (需 LiteLLM 配置 + vLLM --served-model-name deepseek-ai/DeepSeek-V4-Flash)
#            openai/gpt-4o, claude-sonnet-4-20250514, gemini/gemini-2.0-flash
